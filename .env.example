# Copy to .env and fill in. Never commit .env.
FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=sqlite:///pay_my_bill.db
# Email: leave MAIL_SERVER empty to log emails to the console instead of sending them.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Pay My Bill <no-reply@example.com>
