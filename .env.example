# Copy to .env and fill in. Never commit .env.
FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=sqlite:///pay_my_bill.db
# Email: set BREVO_API_KEY to send through Brevo over HTTPS (Render free blocks SMTP).
BREVO_API_KEY=
# Or leave MAIL_SERVER empty to log emails to the console instead of sending them.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Pay My Bill <no-reply@example.com>
# The site address. Every link in emails and to Stripe is built from it, so set it to the real https URL in production.
APP_URL=http://localhost:5000
# Stripe Connect for card gifts (ADR 0014). Leave empty to hide card gifts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Post photos (ADR 0015). Leave R2_BUCKET empty to keep photos in PHOTO_DIR
# (default: instance/uploads), served by the app for local development.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
PHOTO_DIR=
# Shown on the Terms and Privacy pages.
CONTACT_EMAIL=support@example.com
